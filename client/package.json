{
  "name": "portfolio-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:prod:gh-pages": "ng build --configuration production --base-href /portfolio/",
    "build:prod:optimized": "npm run optimize-model && npm run build:prod",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "preview": "cd dist/portfolio-client/browser && python3 -m http.server 8080",
    "optimize-model": "node scripts/optimize-model.js public/models/batcave.glb public/models/batcave.compressed.glb"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@gltf-transform/core": "^4.2.0",
    "@gltf-transform/extensions": "^4.2.0",
    "@gltf-transform/functions": "^4.2.0",
    "@types/d3": "^7.4.3",
    "@types/d3-shape": "^3.1.7",
    "@types/gsap": "^1.20.2",
    "@types/three": "^0.177.0",
    "animate.css": "^4.1.1",
    "d3": "^7.9.0",
    "d3-shape": "^3.2.0",
    "draco3d": "^1.5.7",
    "gsap": "^3.13.0",
    "rxjs": "~7.8.0",
    "sharp": "^0.34.2",
    "three": "^0.177.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.2",
    "@angular/cli": "^20.0.2",
    "@angular/compiler-cli": "^20.0.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "autoprefixer": "^10.4.21",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.10",
    "typescript": "~5.8.2"
  }
}
